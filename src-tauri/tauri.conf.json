{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "storeman",
  "version": "0.1.0",
  "identifier": "dev.nipsys.storeman",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "storeman",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "cli": {
      "description": "Storeman - A simple Tauri desktop application for uploading and downloading files from Codex",
      "args": [
        {
          "name": "port",
          "short": "p",
          "description": "Custom port for the storage node",
          "takesValue": true
        },
        {
          "name": "data-dir",
          "short": "d",
          "description": "Custom data directory for storage",
          "takesValue": true
        }
      ]
    }
  }
}
